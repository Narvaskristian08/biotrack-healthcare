# Required for web API calls.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Optional: only needed for Admin map picker on /admin/users.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: enables Google OAuth login button on /login.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# Optional fallback for patient self-funded extraction if a record does not include contractAddress.
NEXT_PUBLIC_BLOCKCHAIN_RECORDS_CONTRACT_ADDRESS=
