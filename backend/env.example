PORT=3000
NODE_ENV=development
TRUST_PROXY=false
# Comma-separated allowed origins. Example:
# CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001
CORS_ORIGIN=http://127.0.0.1:3001,http://localhost:3001

MONGODB_URI=mongodb://127.0.0.1:27017/biotrack
MONGODB_APP_NAME=biotrack-backend
# Use true for remote/production MongoDB. Set to false only for local non-TLS MongoDB.
MONGODB_REQUIRE_TLS=true
MONGODB_TLS_ENABLED=true
MONGODB_TLS_CA_FILE=
MONGODB_TLS_CERT_KEY_FILE=
MONGODB_TLS_ALLOW_INVALID_CERTS=false
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_HEARTBEAT_FREQUENCY_MS=10000
MONGODB_AUTO_INDEX=true
ENFORCE_STRONG_SECRETS=false

# JWT secrets (use long random strings)
ADMIN_JWT_SECRET=change_me_admin_secret
HEALTHCENTER_JWT_SECRET=change_me_healthcenter_secret
SESSION_JWT_SECRET=change_me_session_secret
JWT_ISSUER=biotrack-healthcare
JWT_AUDIENCE=biotrack-app

# Token TTLs (supported: ms, s, m, h, d)
ACCESS_TOKEN_TTL=12h
SESSION_TOKEN_TTL=12h
# Legacy fallback inactivity timeout (used when role-specific timeout is not set)
SESSION_IDLE_TIMEOUT=30m
# Role-based inactivity timeout overrides
PROVIDER_SESSION_IDLE_TIMEOUT=15m
PATIENT_SESSION_IDLE_TIMEOUT=30m
ADMIN_SESSION_IDLE_TIMEOUT=15m
# Minimum interval between activity timestamp updates
SESSION_ACTIVITY_TOUCH_INTERVAL=60s
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
PATIENT_LOGIN_MFA_REQUIRED=true
MFA_LOGIN_MAX_ATTEMPTS=5
PASSWORD_MIN_LENGTH=12
# Optional startup bootstrap admin (idempotent)
DEFAULT_ADMIN_BOOTSTRAP_ENABLED=false
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=StrongPass!1234

# Login abuse protection
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
MFA_VERIFY_RATE_LIMIT_WINDOW_MS=900000
MFA_VERIFY_RATE_LIMIT_MAX=10
XSS_INPUT_PROTECTION_ENABLED=true
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

# CSRF protection for browser clients
CSRF_ENABLED=true
CSRF_COOKIE_NAME=biotrack_csrf
CSRF_HEADER_NAME=x-csrf-token
CSRF_COOKIE_SECURE=false

# AI / LLM
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional email verification delivery (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional SMS verification delivery (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=+63

# Optional Google OAuth
GOOGLE_OAUTH_CLIENT_ID=

# Blockchain (EVM)
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_STRICT_MODE=false
BLOCKCHAIN_WRITE_DISABLED=false
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/your-project-id
# Single signing key (legacy mode)
BLOCKCHAIN_PRIVATE_KEY=0xyourprivatekey
# Key-rotation mode: comma-separated keys, active key chosen by index.
# Example:
# BLOCKCHAIN_PRIVATE_KEYS=0xkey_old,0xkey_new
# BLOCKCHAIN_ACTIVE_KEY_INDEX=1
BLOCKCHAIN_PRIVATE_KEYS=
BLOCKCHAIN_ACTIVE_KEY_INDEX=0
BLOCKCHAIN_EXPECTED_SIGNER=0x0000000000000000000000000000000000000000
# Safety guard: keep false until testnet validation is complete.
BLOCKCHAIN_ALLOW_MAINNET=false
BLOCKCHAIN_IDENTITIES_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BLOCKCHAIN_RECORDS_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Data protection
# Keys accept 32-byte UTF-8, 64-char hex, or base64-encoded 32 bytes.
DATA_ENCRYPTION_ENABLED=true
DATA_ENCRYPTION_KEY=
BACKUP_OUTPUT_DIR=../backups
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_REQUIRED=true
BACKUP_MAX_DOCUMENTS_PER_COLLECTION=5000
